{
  "schemaVersion": 1,
  "id": "witch-addon",
  "version": "${version}",
  "name": "Witch Addon",
  "description": "Modulos extras do Witch Client para o Meteor Client.",
  "authors": ["Bisteck"],
  "contact": {
    "sources": "https://github.com/henriquenatan288-ui/Witch-Addon"
  },
  "icon": "assets/witch/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": ["com.witch.addon.WitchAddon"]
  },
  "mixins": ["witch-addon.mixins.json"],
  "custom": {
    "meteor-client:color": "47,123,255",
    "modmenu": { "parent": { "id": "meteor-client" } }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
